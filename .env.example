# Template for local PostgreSQL credentials. Copy to `.env` and fill in the real
# local password. `.env` is git-ignored; `.env.example` is safe to commit (it
# carries NO real secret). See AGENTS.md 10 / 15.
HRMS_DB_HOST=localhost
HRMS_DB_PORT=5432
HRMS_DB_NAME=hrms
HRMS_DB_URL=jdbc:postgresql://localhost:5432/hrms
HRMS_DB_USERNAME=hrms_app
HRMS_DB_PASSWORD=your_local_password_here
